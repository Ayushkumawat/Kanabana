# Atlas connection string from Connect → Drivers. Encode any special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kanabana

# Long random string. Required when NODE_ENV=production (the Docker image sets that).
JWT_SECRET=replace-with-a-long-random-string

PORT=4050

# Office mailbox. Gmail app passwords can include spaces; they are ignored.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=developer@aiunika.com
SMTP_PASS=replace-with-the-mailbox-app-password
SMTP_FROM=developer@aiunika.com

# Google Calendar connection used to create the Meet link on each scheduled meeting.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Only for an empty database. Loads the sample office (admin@kanabana.local / Admin123!).
# SEED_DEMO=1

# Only for an empty database when you are not copying the SQLite file.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
# BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# BOOTSTRAP_ADMIN_NAME=Admin
